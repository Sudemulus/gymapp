// Faz 1 veritabani semasi: users, exercises, workouts, workout_sets

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum MuscleGroup {
  CHEST
  BACK
  SHOULDERS
  BICEPS
  TRICEPS
  LEGS
  CORE
  CARDIO
  FULL_BODY
  OTHER
}

model User {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(100)
  email        String   @unique @db.VarChar(150)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  workouts         Workout[]
  bodyMeasurements BodyMeasurement[]

  @@map("users")
}

model Exercise {
  id          Int         @id @default(autoincrement())
  name        String      @unique @db.VarChar(150)
  muscleGroup MuscleGroup @map("muscle_group")
  description String?     @db.Text
  createdAt   DateTime    @default(now()) @map("created_at")

  workoutSets WorkoutSet[]

  @@map("exercises")
}

model Workout {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  name      String   @db.VarChar(150)
  date      DateTime @db.Date
  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sets WorkoutSet[]

  @@index([userId])
  @@map("workouts")
}

model WorkoutSet {
  id         Int      @id @default(autoincrement())
  workoutId  Int      @map("workout_id")
  exerciseId Int      @map("exercise_id")
  setNumber  Int      @map("set_number")
  weightKg   Decimal  @map("weight_kg") @db.Decimal(6, 2)
  reps       Int
  completed  Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  workout  Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@index([workoutId])
  @@index([exerciseId])
  @@map("workout_sets")
}

model BodyMeasurement {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  weight    Decimal  @db.Decimal(5, 2)
  chest     Decimal? @db.Decimal(5, 2)
  waist     Decimal? @db.Decimal(5, 2)
  biceps    Decimal? @db.Decimal(5, 2)
  thigh     Decimal? @db.Decimal(5, 2)
  date      DateTime @db.Date
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("body_measurements")
}
